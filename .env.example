# --- Required ---------------------------------------------------------------
# Supabase: from `npx supabase status` (local) or Project Settings > API (hosted)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of the site, used for absolute links in share previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Legal (IT Rules 2021): shown on /grievance -----------------------------
NEXT_PUBLIC_OPERATOR_NAME=Sambhal
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
NEXT_PUBLIC_GRIEVANCE_ADDRESS=

# --- Optional: push notifications (free) ------------------------------------
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string. Put the same value in the database (see README > Push notifications).
PUSH_WEBHOOK_SECRET=

# --- Optional: phone sign-in (needs a paid SMS provider in Supabase) ---------
NEXT_PUBLIC_PHONE_AUTH=false

# --- Optional: error alerts to a Slack or Discord incoming webhook (free) ----
ERROR_WEBHOOK_URL=
